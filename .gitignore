# ========================================
# NeuroAssist AI v2 — .gitignore
# ========================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
*.egg
.mypy_cache/
.ruff_cache/
.pytest_cache/
htmlcov/
.coverage

# ---- Virtual environments ----
venv/
.venv/
env/

# ---- Node ----
node_modules/
frontend/dist/
frontend/.vite/
*.tsbuildinfo

# ---- Environment ----
.env
.env.local
.env*.local
.env.production
!.env.example

# ---- IDE ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- ML Artifacts (large files) ----
ml/checkpoints/*.pt
ml/checkpoints/*.pth
ml/checkpoints/*.onnx
ml/data/raw/
ml/data/processed/
ml/data/preprocessed/MildDemented/
ml/data/preprocessed/ModerateDemented/
ml/data/preprocessed/NonDemented/
ml/data/preprocessed/VeryMildDemented/
ml/reports/*.png
ml/reports/*.json

# ---- Uploads & Exports ----
uploads/
exports/

# ---- RAG Index ----
backend/services/rag/faiss_index/
backend/services/rag/guideline_docs/*.pdf

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Docker ----
docker-compose.override.yml

# ---- Logs ----
*.log
logs/
