# ========================================
# NeuroAssist AI v2 — Environment Variables
# Copy this file to .env and fill in values
# NEVER commit .env to version control
# ========================================

# ---- MongoDB ----
MONGODB_URI=mongodb://localhost:27017/neuroassist_v2
MONGODB_DB_NAME=neuroassist_v2

# ---- JWT Authentication ----
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_GENERATED_SECRET_64_CHARS_MIN
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Groq API (LLM Provider) ----
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=REPLACE_WITH_YOUR_GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Backend Server ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Frontend (Vite reads VITE_ prefix) ----
VITE_API_BASE_URL=http://localhost:8000/api

# ---- AI / ML ----
DATASET_PATH=./ml/data/raw
MODEL_SAVE_DIR=./ml/checkpoints
BEST_MODEL_PATH=./ml/checkpoints/best_model.pt

# ---- Object Storage (MRI files) ----
# For local dev, files are stored in ./uploads/mri/
# For production, configure one of:
# STORAGE_BACKEND=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=
# Or:
# STORAGE_BACKEND=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
STORAGE_BACKEND=local
LOCAL_UPLOAD_DIR=./uploads/mri
# HIPAA compliance: 32-byte Fernet key for file encryption at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_ENCRYPTION_KEY=

# ---- RAG ----
RAG_DOCS_DIR=./backend/services/rag/guideline_docs
FAISS_INDEX_DIR=./backend/services/rag/faiss_index
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=5

# ---- PDF Generation ----
PDF_OUTPUT_DIR=./exports/pdfs

# ---- Kaggle (for dataset download only) ----
# Place your kaggle.json in ~/.kaggle/ or set these:
# KAGGLE_USERNAME=
# KAGGLE_KEY=

# ---- Redis (optional, for async task queue) ----
REDIS_URL=redis://localhost:6379/0

# ---- Compliance ----
DECISION_SUPPORT_MODE_ONLY=true
